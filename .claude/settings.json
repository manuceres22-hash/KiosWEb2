{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": ["mcp__codegraph__*"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codegraph.sh",
